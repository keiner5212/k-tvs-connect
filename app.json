{
    "expo": {
        "name": "K Routes",
        "slug": "k-routes",
        "version": "0.1.0",
        "orientation": "portrait",
        "icon": "./src/assets/images/icon.png",
        "splash": {
            "image": "./src/assets/images/splash-icon.png",
            "resizeMode": "contain",
            "backgroundColor": "#ffffff"
        },
        "newArchEnabled": false,
        "platforms": [
            "android",
            "ios"
        ],
        "android": {
            "package": "com.kroutes.app",
            "adaptiveIcon": {
                "foregroundImage": "./src/assets/images/android-icon-foreground.png",
                "backgroundImage": "./src/assets/images/android-icon-background.png",
                "monochromeImage": "./src/assets/images/android-icon-monochrome.png"
            },
            "softwareKeyboardLayoutMode": "pan",
            "permissions": [
                "android.permission.INTERNET",
                "android.permission.ACCESS_NETWORK_STATE",
                "android.permission.ACCESS_FINE_LOCATION",
                "android.permission.ACCESS_COARSE_LOCATION",
                "android.permission.POST_NOTIFICATIONS"
            ]
        },
        "ios": {
            "supportsTablet": true,
            "bundleIdentifier": "com.kroutes.app",
            "infoPlist": {
                "NSLocationWhenInUseUsageDescription": "Allow $(PRODUCT_NAME) to show your position and plan routes from where you are.",
                "ITSAppUsesNonExemptEncryption": false
            }
        },
        "plugins": [
            "expo-font",
            "expo-asset",
            [
                "expo-sqlite",
                {
                    "useSQLCipher": true
                }
            ],
            "@maplibre/maplibre-react-native",
            [
                "expo-notifications",
                {
                    "color": "#E4002B"
                }
            ],
            "./plugins/withAppBackupPolicy",
            "./plugins/withSharedLocation"
        ],
        "scheme": "kroutes"
    }
}
