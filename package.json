{
  "name": "k-tvs-connect",
  "version": "0.1.0",
  "main": "index.ts",
  "private": true,
  "scripts": {
    "preinstall": "node -e \"const p=process.env.npm_config_user_agent||''; if(p.includes('pnpm')||p.includes('yarn')){console.error('k-tvs-connect: use npm only (Expo).'); process.exit(1)}\"",
    "start": "expo start --dev-client --clear",
    "prebuild": "expo prebuild",
    "clean": "rm -rf node_modules ios android && npm install",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test": "jest --runInBand --passWithNoTests",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/vector-icons": "15.0.3",
    "@maplibre/maplibre-react-native": "10.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@react-navigation/bottom-tabs": "7.4.1",
    "@react-navigation/native": "7.4.1",
    "@react-navigation/native-stack": "7.12.0",
    "babel-preset-expo": "54.0.10",
    "expo": "~54.0.37",
    "expo-asset": "~12.0.14",
    "expo-crypto": "15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-font": "~14.0.12",
    "expo-location": "19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-secure-store": "15.0.8",
    "expo-sqlite": "16.0.10",
    "expo-status-bar": "~3.0.8",
    "expo-task-manager": "~14.0.9",
    "i18next": "23.7.6",
    "nativewind": "2.0.11",
    "react": "19.1.0",
    "react-i18next": "14.0.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "4.16.0",
    "tailwindcss": "3.1.8",
    "zustand": "5.0.2"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "25.2.1",
    "@types/react": "19.1.17",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "babel-plugin-module-resolver": "5.0.3",
    "eslint": "9.39.3",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-native": "5.0.0",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.18",
    "typescript": "5.9.3"
  },
  "overrides": {
    "react-native": "0.81.5",
    "@react-native/virtualized-lists": "0.81.5"
  },
  "jest": {
    "projects": [
      {
        "preset": "jest-expo/ios"
      },
      {
        "preset": "jest-expo/android"
      }
    ]
  }
}
